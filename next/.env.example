# Next.js Environment Variables
# Copy this file to .env.local and update the values as needed

# Strapi API URL
# The base URL of your Strapi backend API
# Default: http://localhost:1337 (for local development)
# Production: Update this to your production Strapi URL
NEXT_PUBLIC_API_URL=http://localhost:1337

# Add the correct ENV var for this onto your hosting platform, point it to your production website.
WEBSITE_URL=http://localhost:3000 
PORT=3000